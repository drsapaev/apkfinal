# ============================================
# Clinic Management System - Android App Configuration
# ============================================

# Backend Configuration
BACKEND_URL=http://192.168.1.100:18000
API_VERSION=v1

# WebSocket Configuration (for real-time updates)
WEBSOCKET_URL=ws://192.168.1.100:18000/ws

# Optional: For production/staging
# BACKEND_URL=https://clinic.example.com
# WEBSOCKET_URL=wss://clinic.example.com/ws

# Gemini AI (Optional - for future AI features)
# GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# App Configuration
APP_NAME=Clinic Manager
LOG_LEVEL=DEBUG

# Debug mode (disable in production)
DEBUG_MODE=true
