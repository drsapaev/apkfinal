# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# NOTE: BACKEND_URL is no longer configured here.
# As of M0/E2.7, the backend URL is set per build type in app/build.gradle.kts:
#   - debug:   http://10.0.2.2:18000/   (Android emulator → host's 127.0.0.1)
#   - release: https://api.clinic.example.com/  (override before release build)
#
# To override for a local development device, edit app/build.gradle.kts or
# pass -PbackendUrl=... via command line.
API_VERSION=v1
