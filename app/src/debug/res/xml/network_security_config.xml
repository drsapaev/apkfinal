<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug network security config.

    E2.6 (M0): permits cleartext traffic to 10.0.2.2 (Android emulator
    maps this to host's 127.0.0.1) and localhost so that the debug build
    can talk to a local FastAPI backend at http://10.0.2.2:18000.

    This config is ONLY applied to the debug build type via sourceSets in
    app/build.gradle.kts. Release builds use the strict
    network_security_config.xml which forbids all cleartext.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
