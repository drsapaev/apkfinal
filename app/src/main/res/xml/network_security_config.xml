<?xml version="1.0" encoding="utf-8"?>
<!--
    Production network security config.

    E2.6 (M0): split into two configs — debug and release.
    This file is the RELEASE config (no cleartext traffic permitted).
    Debug config (network_security_config_debug.xml) permits cleartext for
    10.0.2.2 / localhost to allow emulator ↔ host backend dev.

    The substitution is wired in app/build.gradle.kts via sourceSets.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
