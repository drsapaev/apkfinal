<?xml version="1.0" encoding="utf-8"?>
<!--
    Stage 4.7 (UI-34 fix): branded monochrome notification icon for
    appointment status notifications.

    On Android 12+ (API 31+), the notification small icon MUST be a
    monochrome (white-on-transparent) vector drawable. The system tintes
    it according to the notification shade theme. System fallbacks like
    `android.R.drawable.ic_dialog_info` render as a generic info bubble
    and look unprofessional.

    This icon is a stylized medical cross (plus sign) — the universal
    symbol for medical/clinic apps. It renders cleanly at small sizes
    (24dp notification icon) and is recognizable in both light and dark
    notification shades.

    The drawable is a single-layer vector path with no gradients or
    multiple colors — required for the monochrome tinting to work.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorControlNormal">
    <!-- Vertical bar of the medical cross -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M10,4 C10,2.895 10.895,2 12,2 C13.105,2 14,2.895 14,4 L14,9 L19,9 C20.105,9 21,9.895 21,11 L21,13 C21,14.105 20.105,15 19,15 L14,15 L14,20 C14,21.105 13.105,22 12,22 C10.895,22 10,21.105 10,20 L10,15 L5,15 C3.895,15 3,14.105 3,13 L3,11 C3,9.895 3.895,9 5,9 L10,9 Z" />
</vector>
